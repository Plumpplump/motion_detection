# Copy to .env and fill in the values you need.

# embedded | openrouter | ollama | custom
VISION_PROVIDER=embedded

# Used by remote providers. For embedded it is ignored.
# VISION_MODEL=google/gemini-2.5-flash
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=

# OpenRouter convenience variable (used when VISION_API_KEY is empty).
# OPENROUTER_API_KEY=sk-or-...

# Request timeout in seconds.
VISION_TIMEOUT=45

# Local detector confidence threshold (0.0 - 1.0).
VISION_THRESHOLD=0.35